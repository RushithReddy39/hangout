# Copy this file to `.env.local` and fill in your own values.

# Supabase project URL (from https://supabase.com > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here

# Supabase anonymous public API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: redirect URL after email confirmation during development.
# By default the app falls back to `${window.location.origin}/dashboard`
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/dashboard
